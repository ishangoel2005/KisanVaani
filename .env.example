# Copy this file to .env and paste your Groq API key.
# Never commit .env or share your key publicly.
GROQ_API_KEY=replace_with_your_groq_api_key

# These defaults are current at the time this starter project was prepared.
# You can change them if your Groq account's available model list changes.
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
